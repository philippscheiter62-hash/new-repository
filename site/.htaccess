# Für Apache-Hoster (z. B. Strato, IONOS, all-inkl)
RewriteEngine On

# 1) Immer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) www -> ohne www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3) Alte WordPress-Adressen weiterleiten (erhält Google-Ranking)
RewriteRule ^impressum/?$ /impressum.html [L,R=301]
RewriteRule ^57-2/?$ /datenschutz.html [L,R=301]
RewriteRule ^datenschutz/?$ /datenschutz.html [L,R=301]
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes).*$ / [L,R=301]

# 4) Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# 5) Browser-Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# 6) Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType font/woff2 .woff2
ErrorDocument 404 /404.html

# 7) Bilder/Manifest
AddType application/manifest+json .webmanifest
<IfModule mod_expires.c>
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
